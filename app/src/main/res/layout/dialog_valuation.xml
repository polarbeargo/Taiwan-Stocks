<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="24dp" android:paddingTop="8dp" android:orientation="vertical">
        <LinearLayout style="@style/MetricRow">
            <TextView style="@style/MetricLabel" android:text="@string/pe_ratio" />
            <TextView android:id="@+id/peRatio" style="@style/MetricValue" />
        </LinearLayout>
        <LinearLayout style="@style/MetricRow">
            <TextView style="@style/MetricLabel" android:text="@string/dividend_yield" />
            <TextView android:id="@+id/dividendYield" style="@style/MetricValue" />
        </LinearLayout>
        <LinearLayout style="@style/MetricRow">
            <TextView style="@style/MetricLabel" android:text="@string/pb_ratio" />
            <TextView android:id="@+id/pbRatio" style="@style/MetricValue" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/valuation_note"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
